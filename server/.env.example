# --- Server ---
PORT=5000
# Long random string used to sign admin login tokens
JWT_SECRET=change-this-to-a-long-random-string
# Comma separated list of allowed frontend origins (leave empty to allow all)
CORS_ORIGIN=

# --- MySQL (either DATABASE_URL or the DB_* values) ---
# DATABASE_URL=mysql://user:password@host:3306/aerolex
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aerolex
# Set to true for cloud MySQL that requires SSL (Aiven, TiDB, PlanetScale, Azure)
DB_SSL=false

# --- First admin account (created automatically on first start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
